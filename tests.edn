#kaocha/v1
;; ^:network marks tests that need the network or a real git checkout even
;; when the declared deps are cached.
{:tests [{:id         :unit
          :test-paths ["test/cljnix"]
          :skip-meta  [:network]}
         {:id         :integration
          :test-paths ["test/integration"]
          :skip-meta  [:network]}
         {:id         :network-integration
          :test-paths ["test/cljnix" "test/integration"]
          :focus-meta [:network]}]
 :reporter [kaocha.report.progress/report]}
