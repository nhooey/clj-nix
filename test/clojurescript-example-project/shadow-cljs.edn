{:source-paths ["src"]
 :dependencies []
 :builds {:app {:target :browser
                :output-dir "public/js"
                :asset-path "/js"
                :modules {:main {:init-fn cljs-example.core/init}}}
          ;; Its namespace is only on the classpath with the :shadow-cljs alias
          :alias-app {:target :browser
                      :output-dir "public/js"
                      :asset-path "/js"
                      :modules {:main {:init-fn cljs-example.alias/init}}}
          ;; Requires the npm package in package.json, for the npmRoot package
          :npm {:target :browser
                :output-dir "public/js"
                :asset-path "/js"
                :modules {:main {:init-fn cljs-example.npm/init}}}}}
